		<e:Scroller id="wenzi" x="84.66" y="22.67" anchorOffsetX="0" width="301" scrollPolicyH="off">
			<e:Group x="-19" anchorOffsetX="0" width="301" anchorOffsetY="0" height="348">
				<e:Label id="message1" text="  我出去叫人" y="10" width="100%" textAlign="center" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" border="false" background="false" x="0" scaleX="1" scaleY="1"/>
				<e:Label id="message2" text="  你的牌好靓哇" y="50" width="100%" textColor="0xEFC586" verticalAlign="middle" size="20" height="26" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message3" text="  我当年横扫澳门五条街" y="90" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message4" text="  算你牛逼" y="130" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message5" text="  输得裤衩都没了" y="170" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message6" text="  谢谢老板" y="210" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message7" text="  玩游戏请先进群" y="250" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message8" text="  别磨蹭快点打牌" y="290" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message9" text="  别跟我抢庄" y="330" width="100%" textColor="0xEFC586" height="26" size="20" background="false" backgroundColor="0x3A3A3A" verticalAlign="middle" x="0" textAlign="center" scaleX="1" scaleY="1"/>
				<e:Label id="message10" text="  我给你们送温暖了" y="370" width="100%" textColor="0xEFC586" size="20" height="26" background="false" backgroundColor="0x000000" verticalAlign="middle" x="0" textAlign="center" scaleX="1" scaleY="1"/>
			</e:Group>
