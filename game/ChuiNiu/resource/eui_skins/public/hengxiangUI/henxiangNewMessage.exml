		<e:Scroller id="wenzi" x="85.5" y="369" anchorOffsetX="0" width="322" scrollPolicyH="on" scrollPolicyV="auto" rotation="-90" height="301" anchorOffsetY="0">
			<e:Group x="-77" width="100%" anchorOffsetY="0" height="100%" y="0.5">
				<e:Label id="message1" text="  我出去叫人" width="100%" textAlign="center" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" border="false" background="false" scaleX="1" scaleY="1" rotation="90" verticalCenter="-4.5" x="398"/>
				<e:Label id="message2" text="  你的牌好靓哇" width="100%" textColor="0xEFC586" verticalAlign="middle" size="20" height="26" background="false" x="358" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
				<e:Label id="message3" text="  我当年横扫澳门五条街" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="318" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
				<e:Label id="message4" text="  算你牛逼" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="278" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
				<e:Label id="message5" text="  输得裤衩都没了" width="100%" textColor="0xEFC586" height="26" size="20" verticalAlign="middle" background="false" x="238" textAlign="center" scaleX="1" scaleY="1" verticalCenter="0.5" rotation="90"/>
				<e:Label id="message6" text="  谢谢老板" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="198" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
				<e:Label id="message7" text="  玩游戏请先进群" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="158" textAlign="center" scaleX="1" scaleY="1" verticalCenter="0.5" rotation="90"/>
				<e:Label id="message8" text="  别磨蹭快点打牌" width="100%" textColor="0xEFC586" size="20" height="26" verticalAlign="middle" background="false" x="118" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
				<e:Label id="message9" text="  别跟我抢庄" width="100%" textColor="0xEFC586" height="26" size="20" background="false" backgroundColor="0x3A3A3A" verticalAlign="middle" x="78" textAlign="center" scaleX="1" scaleY="1" verticalCenter="0.5" rotation="90"/>
				<e:Label id="message10" text="  我给你们送温暖了" width="100%" textColor="0xEFC586" size="20" height="26" background="false" backgroundColor="0x000000" verticalAlign="middle" x="38" textAlign="center" scaleX="1" scaleY="1" rotation="90" verticalCenter="0.5"/>
			</e:Group>
